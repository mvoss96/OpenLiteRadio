/dts-v1/;
#include <st/f1/stm32f103Xb.dtsi>
#include <st/f1/stm32f103r(8-b)tx-pinctrl.dtsi>

/ {
    model = "OpenLiteRadio compatibility probe";
    compatible = "openliteradio,lr4-probe";
    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
    };
};

/* HSI avoids assuming an external oscillator frequency. USB needs another clock setup. */
&rcc {
    clocks = <&clk_hsi>;
    clock-frequency = <DT_FREQ_M(8)>;
    ahb-prescaler = <1>;
    apb1-prescaler = <1>;
    apb2-prescaler = <1>;
};

&usart1 {
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";
    current-speed = <400000>;
    status = "okay";
};

&adc1 {
    pinctrl-0 = <&adc1_in0_pa0 &adc1_in1_pa1 &adc1_in2_pa2 &adc1_in3_pa3>;
    pinctrl-names = "default";
    status = "okay";
};

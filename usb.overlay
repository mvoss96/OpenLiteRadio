/ {
    hid_probe: hid-probe {
        compatible = "zephyr,hid-device";
        label = "OpenLiteRadio probe";
        protocol-code = "none";
        in-polling-period-us = <1000>;
        in-report-size = <8>;
    };
};

/* HSI/2 * 12 supplies 48 MHz for a compile-only USB configuration. */
&pll {
    clocks = <&clk_hsi>;
    mul = <12>;
    usbpre;
    status = "okay";
};

&rcc {
    clocks = <&pll>;
    clock-frequency = <DT_FREQ_M(48)>;
    apb1-prescaler = <2>;
};

zephyr_udc0: &usb {
    pinctrl-0 = <&usb_dm_pa11 &usb_dp_pa12>;
    pinctrl-names = "default";
    status = "okay";
    cdc_probe: cdc-probe {
        compatible = "zephyr,cdc-acm-uart";
    };
};
